# BMONI Embedded API — server-side only, never exposed to the browser.
# Sandbox: the shared dev key from BMONI's docs, works only against BASE_URL below.
# Get your own key from developers@bkey.me before touching production.
BMONI_API_KEY=pk_a025cacbf33a_76fb864113f3540909de5b1da39cc146906e35b1c6d4d1e4
BMONI_BASE_URL=https://embedded-dev.bmoni.com

# HMAC secret for signing the session cookie (bmoniUserId only — not a full accounts system).
SESSION_SECRET=change-me-to-a-long-random-string

# HMAC secret BMONI signs webhook deliveries with (from POST /v1/webhooks/config response).
BMONI_WEBHOOK_SECRET=

# Oracle's monetization: the wallet address that collects the performance
# fee on "Make it real" (see src/lib/fees.ts). Required for
# /api/proposals/recommend — it fails closed without this, on purpose.
ORACLE_FEE_WALLET_ADDRESS=
# Fee in basis points (50 = 0.5%). Capped at 1000 (10%) server-side.
ORACLE_FEE_BPS=50
